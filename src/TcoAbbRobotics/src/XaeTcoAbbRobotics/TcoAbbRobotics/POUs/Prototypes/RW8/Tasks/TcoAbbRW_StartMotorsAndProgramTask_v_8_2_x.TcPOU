<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="TcoAbbRW_StartMotorsAndProgramTask_v_8_2_x" Id="{f2ab5800-9783-4765-9a37-5099c7a14ba4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK TcoAbbRW_StartMotorsAndProgramTask_v_8_2_x EXTENDS TcoAbbRWTask_v_8_2_x



]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF Execute() THEN
	 _blink(inOnTime:=T#500MS,inOffTime:=T#500MS);
	IF _progress = 0 THEN
		IF CheckReferences() THEN
			_progress := _progress + 1;
		END_IF
	END_IF
	IF _progress = 1 THEN
		ReleaseStopCommands();
		_varInfo :=__VARINFO( inoStatus.State.AutoOn);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.AutoOn).Warning(_sb.Clear().Append('<#Waiting for Auto signal! #>').Append(_varInfo.Symbol).ToString());
		IF inoStatus.State.MotorOnState AND inoStatus.State.CycleOn AND NOT inoStatus.State.Error THEN
			// the motors are on and the program is already running
			_progress := 8;
		ELSIF  inoStatus.State.AutoOn THEN
			_progress := _progress + 1;
		END_IF;
	END_IF;
	IF _progress = 2 THEN
		Messenger.Debug('<#Robot Error Reset#>');
		inoControl.ResetError := inoStatus.State.Error AND _blink.outQ;
		IF NOT inoStatus.State.Error THEN
			inoControl.ResetError:=FALSE;
			_progress := _progress + 1;
		END_IF
	END_IF;

	IF _progress = 3 THEN
		Messenger.Debug('<#Robot Emergency Stop Reset#>');
		inoControl.ResetEmgStop := inoStatus.State.EmgStop AND _blink.outQ;
		IF NOT inoStatus.State.EmgStop THEN
			inoControl.ResetEmgStop:=FALSE;
			_progress := _progress + 1;
		END_IF
	END_IF;

	// order given by RobotWare 8: write access, motors on, start, release of write access
	IF _progress = 4 THEN
		IF inoStatus.State.Error THEN
			_progress := 1;
		ELSIF AcquireWriteAccess() THEN
			_progress := _progress + 1;
		END_IF
	END_IF;

	IF _progress = 5 THEN
		IF inoStatus.State.Error THEN
			inoControl.MotorOn := FALSE;
			_progress := 1;
		ELSIF MotorsOn() THEN
			_pulseTimer(IN := FALSE);
			_progress := _progress + 1;
		END_IF
	END_IF;

	IF _progress = 6 THEN
		inoControl.StartProgram := Pulse();
		_varInfo :=__VARINFO( inoStatus.State.CycleOn);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.CycleOn).Warning(_sb.Clear().Append('<#Waiting for program running signal! #>').Append(_varInfo.Symbol).ToString());
		IF inoStatus.State.CycleOn AND NOT inoControl.StartProgram THEN
			_progress := _progress + 1;
		END_IF
	END_IF;

	IF _progress = 7 THEN
		IF ReleaseWriteAccess() THEN
			_progress := _progress + 1;
		END_IF
	END_IF;

	DoneWhen(_progress = 8);
	CallTimers(TRUE);
	THIS^.ThrowWhen(_errorTimer.Q );
END_IF

IF  THIS^.Error AND NOT _errorMessage.Pinned THEN
	THIS^.Restore();
END_IF]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{3ce3cb80-2219-4076-a5d4-83a49e3e39e3}">
      <Declaration><![CDATA[METHOD PUBLIC FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
    bInCopyCode : BOOL; // if TRUE, the instance afterwards gets moved into the copy code (online change)
    ParentObject : ITcoObject;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAbort" Id="{48adc54a-a8a5-442e-8fb6-cd6344e56bc7}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task is aborted.
		</summary>			
	</docu>	
~*)
METHOD PROTECTED OnAbort
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF  __ISVALIDREF(inoStatus) THEN   THIS^.inoStatus.ActionDescription := '<#Start motors and program was aborted.#>'; END_IF;
Cleanup();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDone" Id="{d2fde25f-4cd6-4402-99c3-26591b72c383}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task reaches the ```Done``` state .
		</summary>			
	</docu>	
~*)
METHOD PROTECTED OnDone
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF  __ISVALIDREF(inoStatus) THEN   THIS^.inoStatus.ActionDescription := '<#Start motors and program finished successfully.#>'; END_IF;
Cleanup();
_progress:=0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{96517f2f-9b0a-446a-a0c8-e943c32f4b5a}">
      <Declaration><![CDATA[METHOD PROTECTED OnError

VAR
	description: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[description := '<#Start motors and program finished with error.#>'; 
IF  __ISVALIDREF(inoStatus) THEN   THIS^.inoStatus.ActionDescription := description; END_IF;
Cleanup();
THIS^._errorMessage.Error(_sb.Clear().Append(description).Append(' To restore acknowledge this alarm.').ToString()).Pin();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStart" Id="{16132f86-7f84-40ac-8ffa-a06e62f31b61}">
      <Declaration><![CDATA[METHOD PROTECTED OnStart 
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF  __ISVALIDREF(inoStatus) THEN  THIS^.inoStatus.ActionDescription := '<#Start motors and program started.#>'; END_IF; 
Activate();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReleaseCommands" Id="{ebca4680-0662-43fb-8475-443008a4466f}">
      <Declaration><![CDATA[METHOD PROTECTED ReleaseCommands
]]></Declaration>
      <Implementation>
        <ST><![CDATA[inoControl.MotorOn := FALSE;
inoControl.StartProgram := FALSE;
inoControl.ResetError := FALSE;
inoControl.ResetEmgStop := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Restore" Id="{f4a70382-2c02-425b-96d3-9180044dcde5}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Restores this instance to the Ready state. Can be called explicitly or from within one of the restore mechanisms.
			<para>
				See also <see cref="PlcDocu.TcoCore.TcoTask.AutoRestorable()"/>
			</para>
		</summary>			
	</docu>	
~*)
METHOD Restore : ITcoRestorable]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.Restore();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>