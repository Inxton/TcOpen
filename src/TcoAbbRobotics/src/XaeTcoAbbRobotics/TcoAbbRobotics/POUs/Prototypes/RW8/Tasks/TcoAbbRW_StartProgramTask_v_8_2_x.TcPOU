<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="TcoAbbRW_StartProgramTask_v_8_2_x" Id="{0482fe7e-73b8-4f20-9816-d6aba2279f99}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK TcoAbbRW_StartProgramTask_v_8_2_x EXTENDS TcoAbbRWTask_v_8_2_x
VAR

	_stopType: TcoAbstractions.eTcoRoboticsStopType;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF Execute() THEN
	IF _progress = 0 THEN
		IF CheckReferences() THEN
			_progress := _progress + 1;
		END_IF
	END_IF
	IF _progress = 1 THEN
		ReleaseStopCommands();
		_varInfo :=__VARINFO( inoStatus.State.AutoOn);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.AutoOn).Warning(_sb.Clear().Append('<#Waiting for Auto signal! #>').Append(_varInfo.Symbol).ToString());
		IF inoStatus.State.CycleOn THEN
			// the program is already running
			_progress := 6;
		ELSIF inoStatus.State.AutoOn THEN
			_progress := _progress + 1;
		END_IF
	END_IF
	IF _progress = 2 THEN
		IF AcquireWriteAccess() THEN
			_progress := _progress + 1;
		END_IF
	END_IF
	IF _progress = 3 THEN
		_varInfo :=__VARINFO( inoStatus.State.MotorOnState);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.MotorOnState).Warning(_sb.Clear().Append('<#Waiting for motors are On! #>').Append(_varInfo.Symbol).ToString());
		IF inoStatus.State.MotorOnState THEN
			_pulseTimer(IN := FALSE);
			_progress := _progress + 1;
		END_IF
	END_IF
	IF _progress = 4 THEN
		// one pulse; the controller accepts it only with write access held and the stop commands released
		inoControl.StartProgram := Pulse();
		_varInfo :=__VARINFO( inoStatus.State.CycleOn);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.CycleOn).Warning(_sb.Clear().Append('<#Waiting for program running signal! #>').Append(_varInfo.Symbol).ToString());
		IF inoStatus.State.CycleOn AND NOT inoControl.StartProgram THEN
			_progress := _progress + 1;
		END_IF
	END_IF
	IF _progress = 5 THEN
		IF ReleaseWriteAccess() THEN
			_progress := _progress + 1;
		END_IF
	END_IF

	DoneWhen(_progress = 6);
	CallTimers(TRUE);
	THIS^.ThrowWhen(_errorTimer.Q OR (_progress > 0 AND_THEN inoStatus.State.Error));
END_IF

IF  THIS^.Error AND NOT _errorMessage.Pinned THEN
	THIS^.Restore();
END_IF]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{84a027cb-03fb-4f2d-a8ad-b6f30e922b4a}">
      <Declaration><![CDATA[METHOD PUBLIC FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
    bInCopyCode : BOOL; // if TRUE, the instance afterwards gets moved into the copy code (online change)
  	ParentObject : ITcoObject;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[		    
                                ]]></ST>
      </Implementation>
    </Method>
    <Method Name="InvokeWithParams" Id="{203260f6-5a79-495a-9246-b297a67f3f0f}">
      <Declaration><![CDATA[METHOD INTERNAL InvokeWithParams : ITcoTaskStatus
VAR_INPUT
	inStopType : eTcoRoboticsStopType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_stopType := inStopType;
InvokeWithParams := THIS^.Invoke();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAbort" Id="{b64b89a3-afbe-4d1c-ab00-882c3fb4e2d2}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task is aborted.
		</summary>			
	</docu>	
~*)
METHOD PROTECTED OnAbort
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF  __ISVALIDREF(inoStatus) THEN   THIS^.inoStatus.ActionDescription := '<#Start program was aborted, while not yet completed!#>';END_IF; 
Cleanup();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDone" Id="{3f21afd1-3942-4384-a0ef-564f48221169}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task reaches the ```Done``` state .
		</summary>			
	</docu>	
~*)
METHOD PROTECTED OnDone
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF  __ISVALIDREF(inoStatus) THEN  THIS^.inoStatus.ActionDescription := '<#Start program was completed successfully.#>';END_IF; 
Cleanup();
_progress:=0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{b3d84d37-dbfb-4be0-aeed-d015f759d0d3}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task reaches the ```Error``` state.
				</summary>			
	</docu>	
~*)
METHOD PROTECTED OnError
VAR
	description: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[description := '<#Start program finished with error.#>';
IF  __ISVALIDREF(inoStatus) THEN   THIS^.inoStatus.ActionDescription := description; END_IF;
Cleanup();
THIS^._errorMessage.Error(_sb.Clear().Append(description).Append(' To restore acknowledge this alarm.').ToString()).Pin();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStart" Id="{4fcacc39-ae5f-4f73-ae41-321e06d71b84}">
      <Declaration><![CDATA[METHOD PROTECTED OnStart 
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF  __ISVALIDREF(inoStatus) THEN  THIS^.inoStatus.ActionDescription := '<#Start program started.#>'; END_IF; 
Activate();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReleaseCommands" Id="{848eab84-d460-470a-984a-2baa0d26485c}">
      <Declaration><![CDATA[METHOD PROTECTED ReleaseCommands
]]></Declaration>
      <Implementation>
        <ST><![CDATA[inoControl.StartProgram := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Restore" Id="{65fc6533-3b81-4adc-8bbc-0b31d4da1dee}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Restores this instance to the Ready state. Can be called explicitly or from within one of the restore mechanisms.
			<para>
				See also <see cref="PlcDocu.TcoCore.TcoTask.AutoRestorable()"/>
			</para>
		</summary>			
	</docu>	
~*)
METHOD Restore : ITcoRestorable]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.Restore();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>