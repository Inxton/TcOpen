<Window x:Class="TcoAteqMeasurement.Wpf.Sandbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tcopen="clr-namespace:TcoAteqMeasurementTests;assembly=TcoAteqMeasurementTestsConnector"
        xmlns:vortex="http://vortex.mts/xaml" 
        Title="MainWindow"
        Width="800"
        Height="450"
        DataContext="{x:Static tcopen:Entry.TcoAteqMeasurementTestsPlc}"
        mc:Ignorable="d">

    <Grid>
        <TabControl>
            <TabItem Header="ATEQ G6">
                <ScrollViewer>
                    <vortex:RenderableContentControl DataContext="{Binding MAIN._wpfContext._ateq1}" PresentationType="Service"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diagnostic">
                <vortex:RenderableContentControl DataContext="{Binding MAIN._wpfContext }" PresentationType="Diagnostics"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
