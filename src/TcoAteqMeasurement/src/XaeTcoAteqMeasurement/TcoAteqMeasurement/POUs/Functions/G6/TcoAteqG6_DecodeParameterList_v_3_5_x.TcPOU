<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="TcoAteqG6_DecodeParameterList_v_3_5_x" Id="{3970dece-86db-44a1-bfd4-a74d90b6a74a}" SpecialFunc="None">
    <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Decodes inCount parameters (identifier WORD + value LONG x1000 each) from inOffset. A count outside 1..35 leaves the list empty.
		</summary>
	</docu>
~*)
FUNCTION TcoAteqG6_DecodeParameterList_v_3_5_x : BOOL
VAR_INPUT
	inOffset : INT;
	inCount : INT;
END_VAR
VAR_IN_OUT
	inoImage : ARRAY[0..255] OF BYTE;
	inoList : TcoAteqG6_ParameterList_v_3_5_x;
END_VAR
VAR
	i : INT;
	pos : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[TcoAteqG6_ClearParameterList_v_3_5_x(inoList := inoList);
IF inCount < 1 OR inCount > 35 THEN
	RETURN;
END_IF
FOR i := 0 TO inCount - 1 DO
	pos := inOffset + 6 * i;
	inoList.Items[i].Id := WORD_TO_UINT(TcoAteqG6_GetWord_v_3_5_x(inOffset := pos, inoImage := inoImage));
	inoList.Items[i].Raw := TcoAteqG6_GetDint_v_3_5_x(inOffset := pos + 2, inoImage := inoImage);
	inoList.Items[i].Value := TcoAteqG6_ToEngineering_v_3_5_x(inoList.Items[i].Raw);
END_FOR
inoList.Count := inCount;
TcoAteqG6_DecodeParameterList_v_3_5_x := TRUE;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>