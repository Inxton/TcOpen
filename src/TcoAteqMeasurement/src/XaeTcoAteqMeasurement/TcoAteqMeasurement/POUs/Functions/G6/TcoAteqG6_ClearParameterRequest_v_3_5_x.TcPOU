  <POU Name="TcoAteqG6_ClearParameterRequest_v_3_5_x" Id="{6791b5a3-76d9-47bc-a833-ff921690e5a6}" SpecialFunc="None">
    <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Clears a parameter request.
		</summary>
	</docu>
~*)
FUNCTION TcoAteqG6_ClearParameterRequest_v_3_5_x : BOOL
VAR_IN_OUT
	inoRequest : TcoAteqG6_ParameterRequest_v_3_5_x;
END_VAR
VAR
