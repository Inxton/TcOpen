VAR_IN_OUT
	inoRequest : TcoAteqG6_ParameterRequest_v_3_5_x;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[TcoAteqG6_ClearParameterRequest_v_3_5_x(inoRequest := inoRequest);
