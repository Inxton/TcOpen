TcoAteqG6_AddParameterToRequest_v_3_5_x(inParameter := eTcoAteqG6_ParameterId_v_3_5_x.DumpTime, inoRequest := inoRequest);
TcoAteqG6_AddParameterToRequest_v_3_5_x(inParameter := eTcoAteqG6_ParameterId_v_3_5_x.TestType, inoRequest := inoRequest);
