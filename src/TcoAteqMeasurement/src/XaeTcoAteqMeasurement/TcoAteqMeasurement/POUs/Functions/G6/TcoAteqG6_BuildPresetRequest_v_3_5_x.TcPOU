TcoAteqG6_AddParameterToRequest_v_3_5_x(inParameter := eTcoAteqG6_ParameterId_v_3_5_x.RefFail, inoRequest := inoRequest);
TcoAteqG6_AddParameterToRequest_v_3_5_x(inParameter := eTcoAteqG6_ParameterId_v_3_5_x.SetFill, inoRequest := inoRequest);
TcoAteqG6_BuildPresetRequest_v_3_5_x := TRUE;]]></ST>
