<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="TcoKukaKss_StopMotorsTask_v_9_3_x" Id="{8333b0bd-72ba-43fe-9f4f-8efa07aae33d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK TcoKukaKss_StopMotorsTask_v_9_3_x EXTENDS TcoKukaKssTask_v_9_3_x
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF Execute() THEN
	_blink(inOnTime:=T#500MS,inOffTime:=T#500MS);

	IF _progress = 0 THEN
		IF CheckReferences() THEN
			_progress := _progress + 1;
		END_IF
	END_IF

	IF _progress = 1 THEN
		// AX step 0: waiting for 'DrivesReady' to be off
		inoControl.DrivesOn := TRUE;
		inoControl.DrivesOff := _blink.outQ;
		_varInfo :=__VARINFO(inoStatus.State.DrivesReady);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND inoStatus.State.DrivesReady).Warning(_sb.Clear().Append('<#Waiting for signal: #>').Append(_varInfo.Symbol).Append('<# is OFF#>').ToString());
		IF NOT inoStatus.State.DrivesReady THEN
			inoControl.DrivesOff := FALSE;
			_progress := _progress + 1;
		END_IF
	END_IF

	IF _progress = 2 THEN
		DoneWhen(TRUE);
	END_IF

	CallTimers(TRUE);
	THIS^.ThrowWhen(_errorTimer.Q);
END_IF

IF THIS^.Error AND NOT _errorMessage.Pinned THEN
	THIS^.Restore();
END_IF]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{6c2e4989-d6b5-4db2-9011-37857022bac2}">
      <Declaration><![CDATA[METHOD PUBLIC FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
    bInCopyCode : BOOL; // if TRUE, the instance afterwards gets moved into the copy code (online change)
    ParentObject : ITcoObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAbort" Id="{1ca06cce-aa25-4df6-a5fe-b06fce993edd}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task is aborted.
		</summary>			
	</docu>	
~*)
METHOD PROTECTED OnAbort
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(inoStatus) THEN THIS^.inoStatus.ActionDescription := '<#Stop motors was aborted.#>'; END_IF;
IF __ISVALIDREF(inoControl) THEN
	inoControl.DrivesOff := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDone" Id="{a69e4a03-5e58-445b-83ee-53216aa932bc}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task reaches the ```Done``` state .
		</summary>			
	</docu>	
~*)
METHOD PROTECTED OnDone
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(inoStatus) THEN THIS^.inoStatus.ActionDescription := '<#Stop motors finished successfully.#>'; END_IF;
_progress := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{c39152c9-f171-42d3-b424-b8e6938a0e62}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task reaches the ```Error``` state.
		</summary>			
	</docu>	
~*)
METHOD PROTECTED OnError
VAR
	description: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[description := '<#Stop motors finished with error.#>';
IF __ISVALIDREF(inoStatus) THEN THIS^.inoStatus.ActionDescription := description; END_IF;
THIS^._errorMessage.Error(_sb.Clear().Append(description).Append(' To restore acknowledge this alarm.').ToString()).Pin();
IF __ISVALIDREF(inoControl) THEN
	inoControl.DrivesOff := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStart" Id="{07b950c7-f888-4bdf-a900-cdd3d877103e}">
      <Declaration><![CDATA[METHOD PROTECTED OnStart
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(inoStatus) THEN THIS^.inoStatus.ActionDescription := '<#Stop motors started.#>'; END_IF;
CallTimers(FALSE);
IF __ISVALIDREF(inoControl) THEN
	inoControl.DrivesOff := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Restore" Id="{9b1133d2-d0c3-41e0-b5a5-1ced76db475d}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Restores this instance to the Ready state. Can be called explicitly or from within one of the restore mechanisms.
			<para>
				See also <see cref="PlcDocu.TcoCore.TcoTask.AutoRestorable()"/>
			</para>
		</summary>
	</docu>
~*)
METHOD Restore : ITcoRestorable]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.Restore();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>