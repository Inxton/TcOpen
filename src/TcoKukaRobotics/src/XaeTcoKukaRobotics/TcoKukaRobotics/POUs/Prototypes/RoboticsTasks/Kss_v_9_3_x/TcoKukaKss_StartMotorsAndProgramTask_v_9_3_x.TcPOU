<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="TcoKukaKss_StartMotorsAndProgramTask_v_9_3_x" Id="{7318ae32-b94a-48f0-990a-20a40bf2cfc7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK TcoKukaKss_StartMotorsAndProgramTask_v_9_3_x EXTENDS TcoKukaKssTask_v_9_3_x
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF Execute() THEN
	_blink(inOnTime:=T#500MS,inOffTime:=T#500MS);

	IF _progress = 0 THEN
		IF CheckReferences() THEN
			_progress := _progress + 1;
		END_IF
	END_IF

	IF _progress = 1 THEN
		// AX step 0: waiting for 'InterfaceActivated'
		inoControl.ActivateInterface := TRUE;
		_varInfo :=__VARINFO(inoStatus.State.InterfaceActivated);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.InterfaceActivated).Warning(_sb.Clear().Append('<#Waiting for signal: #>').Append(_varInfo.Symbol).ToString());
		IF inoStatus.State.InterfaceActivated THEN
			_progress := _progress + 1;
		END_IF
	END_IF

	IF _progress = 2 THEN
		// AX step 1: enable, try to acknowledge errors, waiting for 'CutEnableDrives'
		inoControl.MoveEnable := TRUE;
		inoControl.DrivesOff := TRUE;
		inoControl.ActionNo := 255;
		inoControl.ErrorConfirmation := inoStatus.State.StopMess AND NOT _blink.outQ;
		_varInfo :=__VARINFO(inoStatus.State.CutEnableDrives);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.CutEnableDrives).Warning(_sb.Clear().Append('<#Waiting for signal: #>').Append(_varInfo.Symbol).ToString());
		IF inoStatus.State.CutEnableDrives THEN
			_progress := _progress + 1;
		END_IF
	END_IF

	IF _progress = 3 THEN
		// AX step 2: waiting for 'AlarmStopActive'
		_varInfo :=__VARINFO(inoStatus.State.AlarmStopActive);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.AlarmStopActive).Warning(_sb.Clear().Append('<#Waiting for signal: #>').Append(_varInfo.Symbol).ToString());
		IF inoStatus.State.AlarmStopActive THEN
			_progress := _progress + 1;
		END_IF
	END_IF

	IF _progress = 4 THEN
		// AX step 3: drives on, waiting for 'DrivesReady'
		inoControl.DrivesOff := TRUE;
		IF inoStatus.State.CutEnableDrives THEN
			inoControl.DrivesOn := _blink.outQ;
		END_IF
		inoControl.ErrorConfirmation := inoStatus.State.StopMess AND NOT _blink.outQ;
		_varInfo :=__VARINFO(inoStatus.State.DrivesReady);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.DrivesReady).Warning(_sb.Clear().Append('<#Waiting for signal: #>').Append(_varInfo.Symbol).ToString());
		IF inoStatus.State.DrivesReady THEN
			inoControl.DrivesOn := FALSE;
			_progress := _progress + 1;
		END_IF
	END_IF

	IF _progress = 5 THEN
		// AX step 4: acknowledge, waiting for 'StopMess' to be off
		inoControl.ErrorConfirmation := inoStatus.State.StopMess AND _blink.outQ;
		_varInfo :=__VARINFO(inoStatus.State.StopMess);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND inoStatus.State.StopMess).Warning(_sb.Clear().Append('<#Waiting for signal: #>').Append(_varInfo.Symbol).Append('<# is OFF#>').ToString());
		IF NOT inoStatus.State.StopMess THEN
			_progress := _progress + 1;
		END_IF
	END_IF

	IF _progress = 6 THEN
		// AX step 5: waiting for 'RcReady'
		inoControl.MoveEnable := TRUE;
		inoControl.ErrorConfirmation := inoStatus.State.AlarmStopActive AND NOT _blink.outQ;
		_varInfo :=__VARINFO(inoStatus.State.RcReady);
		THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.RcReady).Warning(_sb.Clear().Append('<#Waiting for signal: #>').Append(_varInfo.Symbol).ToString());
		IF inoStatus.State.RcReady THEN
			_progress := _progress + 1;
		END_IF
	END_IF

	IF _progress = 7 THEN
		// AX step 6: external start, waiting for 'ProActive'
		IF inoStatus.State.StopMess OR NOT inoStatus.State.RcReady OR inoStatus.State.NormalStop THEN
			inoControl.ExternalStart := FALSE; // not in AX: do not leave EXT_START high while the sequence restarts
			_progress := 1;
		ELSE
			inoControl.ExternalStart := _blink.outQ;
			_varInfo :=__VARINFO(inoStatus.State.ProActive);
			THIS^.Messenger.OnCondition(_infoTimer.Q AND NOT inoStatus.State.ProActive).Warning(_sb.Clear().Append('<#Waiting for program running signal! #>').Append(_varInfo.Symbol).ToString());
			IF inoStatus.State.ProActive THEN
				inoControl.ExternalStart := FALSE;
				_progress := _progress + 1;
			END_IF
		END_IF
	END_IF

	IF _progress = 8 THEN
		DoneWhen(TRUE);
	END_IF

	CallTimers(TRUE);
	THIS^.ThrowWhen(_errorTimer.Q);
END_IF

IF THIS^.Error AND NOT _errorMessage.Pinned THEN
	THIS^.Restore();
END_IF]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{1aa7c184-ba28-48ff-9a1f-2536ef6c24b7}">
      <Declaration><![CDATA[METHOD PUBLIC FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
    bInCopyCode : BOOL; // if TRUE, the instance afterwards gets moved into the copy code (online change)
    ParentObject : ITcoObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAbort" Id="{ff156ad4-dbe5-4a0f-bf9c-67156f37f2ac}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task is aborted.
		</summary>			
	</docu>	
~*)
METHOD PROTECTED OnAbort
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(inoStatus) THEN THIS^.inoStatus.ActionDescription := '<#Start motors and program was aborted.#>'; END_IF;
IF __ISVALIDREF(inoControl) THEN
	inoControl.DrivesOn := FALSE;
	inoControl.ExternalStart := FALSE;
	inoControl.ErrorConfirmation := FALSE;
	inoControl.MoveEnable := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDone" Id="{2fe1073f-8221-4bf6-bb93-2acb4195c494}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task reaches the ```Done``` state .
		</summary>			
	</docu>	
~*)
METHOD PROTECTED OnDone
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(inoStatus) THEN THIS^.inoStatus.ActionDescription := '<#Start motors and program finished successfully.#>'; END_IF;
_progress := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnError" Id="{543f4175-6306-4d50-8578-ba279f2c447e}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Executes when task reaches the ```Error``` state.
		</summary>			
	</docu>	
~*)
METHOD PROTECTED OnError
VAR
	description: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[description := '<#Start motors and program finished with error.#>';
IF __ISVALIDREF(inoStatus) THEN THIS^.inoStatus.ActionDescription := description; END_IF;
THIS^._errorMessage.Error(_sb.Clear().Append(description).Append(' To restore acknowledge this alarm.').ToString()).Pin();
IF __ISVALIDREF(inoControl) THEN
	inoControl.DrivesOn := FALSE;
	inoControl.ExternalStart := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStart" Id="{5f896262-3b9d-426c-9328-cce56b57ce24}">
      <Declaration><![CDATA[METHOD PROTECTED OnStart
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(inoStatus) THEN THIS^.inoStatus.ActionDescription := '<#Start motors and program started.#>'; END_IF;
CallTimers(FALSE);
IF __ISVALIDREF(inoControl) THEN
	inoControl.DrivesOn := FALSE;
	inoControl.ExternalStart := FALSE;
	inoControl.ActivateInterface := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Restore" Id="{f8b2bce6-82a4-4dc7-bc66-a021f76d2813}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Restores this instance to the Ready state. Can be called explicitly or from within one of the restore mechanisms.
			<para>
				See also <see cref="PlcDocu.TcoCore.TcoTask.AutoRestorable()"/>
			</para>
		</summary>
	</docu>
~*)
METHOD Restore : ITcoRestorable]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.Restore();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>