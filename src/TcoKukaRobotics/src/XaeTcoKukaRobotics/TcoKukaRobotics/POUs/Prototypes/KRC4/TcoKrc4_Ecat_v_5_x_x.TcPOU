_status.State.Coordinates.Rz:=(DINT_TO_REAL(_bytes)/10000.0);

index:=44;
_status.State.EventId:=TcoUtilities.TcoBytesToUDint (inFormat:=TcoUtilities.eTcoDataFormat.LittleEndian,
															inByte0:= inoData.In.Inputs[index],
