_status.State.Coordinates.Z:=(DINT_TO_REAL(_bytes)/10000.0);

index:=32;															
_bytes:=TcoUtilities.TcoBytesToDint (inFormat:=TcoUtilities.eTcoDataFormat.LittleEndian,
