<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="TcoKukaKssPn_v_9_3_x" Id="{726e7061-9b34-4132-9e87-0b691cbf9282}" SpecialFunc="None">
    <Declaration><![CDATA[(*~
	<docu>
		<summary>
			KUKA robot controller running KSS / iiQKA.OS2 9.3 (PN).
			The interface uses 64 input and 64 output bytes. Compared to TcoKrc4 v5 it adds LocalEstopOk, NormalStop,
			CutEnableDrives, user data in both directions and a new start sequence (interface is activated first,
			drives are switched on only when CutEnableDrives is present).
		</summary>
	</docu>
~*)
FUNCTION_BLOCK TcoKukaKssPn_v_9_3_x EXTENDS TcoIo.TcoPnIoComponent IMPLEMENTS TcoAbstractions.ITcoRobotics
VAR_INPUT
    inEnable : BOOL;
END_VAR
VAR_OUTPUT
END_VAR
VAR_IN_OUT
    inoData : TcoKukaKssPn_IO_v_9_3_x;
END_VAR
VAR
	{attribute addProperty Name "<#Status#>"}
    {attribute clr [ReadOnly()]}
    _status : TcoKukaKss_Status_v_9_3_x;
	{attribute addProperty Name "<#Control#>"}
	_control : TcoKukaKss_Control_v_9_3_x;
	{attribute addProperty Name "<#Config#>"}
    _config : TcoKukaKss_Config_v_9_3_x;
	{attribute addProperty Name "<#PN Error#>"}
    {attribute clr [ReadOnly()]}
    _busError : BOOL;

	_someTaskIsActive : BOOL;
	_stopTasksAreActive : BOOL;

	_reportTimer : TON;
	_errorReportTimer : TON;
	{attribute 'hide'}
	_manualPV : BOOL;
END_VAR
VAR
	{attribute addProperty Name "<#Start at Main#>"}
	_startAtMainTask : TcoKukaKss_StartAtMainTask_v_9_3_x(THIS^);

	{attribute addProperty Name "<#Start motors and program#>"}
	_startMotorsAndProgramTask : TcoKukaKss_StartMotorsAndProgramTask_v_9_3_x(THIS^);

	{attribute addProperty Name "<#Start program#>"}
	_startProgramTask : TcoKukaKss_StartProgramTask_v_9_3_x(THIS^);

	{attribute addProperty Name "<#Start motors#>"}
	_startMotorsTask : TcoKukaKss_StartMotorsTask_v_9_3_x(THIS^);

	{attribute addProperty Name "<#Start movements#>"}
	_startMovementsTask : TcoKukaKss_StartMovementsTask_v_9_3_x(THIS^);

	{attribute addProperty Name "<#Start motors program and movements#>"}
	_startMotorsProgramAndMovementsTask : TcoKukaKss_StartMotorsProgramAndMovementsTask_v_9_3_x(THIS^);

	{attribute addProperty Name "<#Stop movements#>"}
	_stopMovementsTask : TcoKukaKss_StopMovementsTask_v_9_3_x(THIS^);

	{attribute addProperty Name "<#Stop movenents and program#>"}
	_stopMovementsAndProgramTask : TcoKukaKss_StopMovementsAndProgramTask_v_9_3_x(THIS^);

	{attribute addProperty Name "<#Stop program#>"}
	_stopProgramTask : TcoKukaKss_StopProgramTask_v_9_3_x(THIS^);

	{attribute addProperty Name "<#Stop motors#>"}
	_stopMotorsTask : TcoKukaKss_StopMotorsTask_v_9_3_x(THIS^);

	{attribute addProperty Name "<#Reset all outputs#>"}
	_resetAllOutputsTask : TcoKukaKss_ResetAllOutputsTask_v_9_3_x(THIS^);

    {attribute addProperty Name "<#Restore#>"}
    _restoreTask : TcoCore.TcoTask(THIS^);
END_VAR
VAR
	{attribute 'hide'}
	_sb : TcoCore.StringBuilder;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT __ISVALIDREF(inoData) THEN
    Messenger.Post('Invalid reference', TcoCore.eMessageCategory.ProgrammingError);
    RETURN;
END_IF

SUPER^(inPnIoBoxState := THIS^.inoData.PnIoBoxState, inPnIoBoxDiag := THIS^.inoData.PnIoBoxDiag);
_busError := NOT _profinetReady;

UpdateStatus();

//MoveEnable follows the manual mode: set on entering manual mode, reset on leaving it
IF _status.State.Manual AND NOT _manualPV THEN
    _control.MoveEnable := TRUE;
ELSIF NOT _status.State.Manual AND _manualPV THEN
    _control.MoveEnable := FALSE;
END_IF
_manualPV := _status.State.Manual;

_stopTasksAreActive := _stopMovementsTask.Busy OR _stopMovementsAndProgramTask.Busy OR _stopProgramTask.Busy OR _stopMotorsTask.Busy;

_startAtMainTask.Enabled := NOT _stopTasksAreActive;
_startAtMainTask(inoConfig := _config, inoControl := _control, inoStatus := _status);

_startProgramTask.Enabled := NOT _stopTasksAreActive AND NOT _startMotorsAndProgramTask.Busy AND NOT _startMotorsTask.Busy;
_startProgramTask(inoConfig := _config, inoControl := _control, inoStatus := _status);

_startMotorsTask.Enabled := NOT _stopTasksAreActive AND NOT _startMotorsProgramAndMovementsTask.Busy AND NOT _startMotorsAndProgramTask.Busy AND NOT _startProgramTask.Busy;
_startMotorsTask(inoConfig := _config, inoControl := _control, inoStatus := _status);

_startMotorsAndProgramTask.Enabled := NOT _stopTasksAreActive AND NOT _startProgramTask.Busy AND NOT _startMotorsTask.Busy;
_startMotorsAndProgramTask(inoConfig := _config, inoControl := _control, inoStatus := _status);

_startMovementsTask.Enabled := NOT _startMotorsProgramAndMovementsTask.Busy AND NOT _stopMotorsTask.Busy;
_startMovementsTask(inoConfig := _config, inoControl := _control, inoStatus := _status);

_startMotorsProgramAndMovementsTask.Enabled := NOT _startMovementsTask.Busy AND NOT _stopMotorsTask.Busy;
_startMotorsProgramAndMovementsTask(refStartMotorsAndProgramTask := _startMotorsAndProgramTask,
    inoConfig := _config,
    inoControl := _control,
    inoStatus := _status);

_stopMovementsTask.Enabled := TRUE;
_stopMovementsTask(inoConfig := _config, inoControl := _control, inoStatus := _status);

_stopMotorsTask.Enabled := TRUE;
_stopMotorsTask(inoConfig := _config, inoControl := _control, inoStatus := _status);

_stopProgramTask.Enabled := TRUE;
_stopProgramTask(inoConfig := _config, inoControl := _control, inoStatus := _status);

_stopMovementsAndProgramTask.Enabled := TRUE;
_stopMovementsAndProgramTask(inoConfig := _config, inoControl := _control, inoStatus := _status);

_someTaskIsActive := _startAtMainTask.Busy OR
    _startProgramTask.Busy OR
    _startMotorsTask.Busy OR
    _startMotorsAndProgramTask.Busy OR
    _startMovementsTask.Busy OR
    _startMotorsProgramAndMovementsTask.Busy OR
    _stopMovementsTask.Busy OR
    _stopMovementsAndProgramTask.Busy OR
    _stopProgramTask.Busy OR
    _stopMotorsTask.Busy;

_resetAllOutputsTask.Enabled := NOT _someTaskIsActive;
_resetAllOutputsTask(inoConfig := _config, inoControl := _control, inoStatus := _status);

//*************RESTORE********************
_restoreTask.Enabled := TRUE;
IF _restoreTask.Execute() THEN
    Restore();
    _restoreTask.DoneWhen(TRUE);
END_IF
//****************************************

//do not publish diagnostic message when component is not used
IF _someTaskIsActive THEN
    IF NOT _status.State.AlarmStopActive THEN
        Messenger.Error('<#Emergency stop active#>');
    END_IF;
    IF NOT _status.State.LocalEstopOk THEN
        Messenger.Error('<#Local emergency stop active#>');
    END_IF;
    IF NOT _status.State.UserSafetySwitchClosed THEN
        Messenger.Warning('<#Safety Error #>');
    END_IF;
END_IF;

_errorReportTimer(IN := _status.State.Error, PT := _config.InfoTime);
Messenger.OnCondition(_errorReportTimer.Q).Error(_sb.Clear()
        .Append('<#Robot reported an error: #>')
        .Append(UDINT_TO_STRING(_status.State.EventId))
        .Append(' |[[0]AdvancedDiagnosticMessage]|')
        .Append('.')
        .Append('For details see the service mode')
        .ToString());

_reportTimer(IN := _status.State.Manual, PT := _config.InfoTime);
Messenger.OnCondition(_reportTimer.Q).Warning('<#Robot in manual mode. MoveEnable is set on entering manual mode!#>');

UpdateControl();]]></ST>
    </Implementation>
