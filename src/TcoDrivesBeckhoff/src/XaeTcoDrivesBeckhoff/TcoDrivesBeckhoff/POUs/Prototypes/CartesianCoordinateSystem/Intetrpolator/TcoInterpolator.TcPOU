        <ST><![CDATA[SoeReset:=THIS^._soeResetDrivesTask.Invoke();


]]></ST>
      </Implementation>
    </Method>
    <Property Name="SoeResetDrivesTask" Id="{67fab9b9-01a4-0024-2faf-98d9b9833e3a}" FolderPath="Tasks\">
      <Declaration><![CDATA[PROPERTY PUBLIC SoeResetDrivesTask : REFERENCE TO TcoCore.TcoTask]]></Declaration>
      <Get Name="Get" Id="{43469d28-4920-0392-1255-492321c0afda}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SoeResetDrivesTask REF=_soeResetDrivesTask;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="StartInterpolation" Id="{babc2452-e86e-43e2-a851-862fab2dab37}" FolderPath="Internal\">
      <Declaration><![CDATA[(*

			DESCRIBE FUNCTION OF THIS METHOD

*)
METHOD PRIVATE StartInterpolation 
VAR_INPUT
	refProgress:REFERENCE TO INT;
	refTask:REFERENCE TO TcoCore.TcoTask;
END_VAR
VAR_INST
	_progress:REFERENCE TO INT;
	_task:REFERENCE TO TcoCore.TcoTask;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_progress REF= refProgress;
_task REF= refTask;

IF _progress = 0 THEN
    //--------------------------------------------------------------  
    // Inicializacia
    interpBuildGroup.bExecute := FALSE;
    interpLoadGCode.bExecute := FALSE;
    interpStartGCode.bStart := FALSE;
    interpStartGCode.bStop := FALSE;
    interpClearGroup.bExecute := FALSE;
    interpReset.bExecute := FALSE;
    interpSingleBlock.bExecuteModeChange := FALSE;

    IF LEN(_control.FileName) <= 0 THEN
        Messenger.Error('<#Invalid file name of interpolation file.#>');
    END_IF

    IF (NOT interpReset.bBusy AND LEN(_control.FileName) > 0) THEN
        _progress := 100;
    END_IF
    //--------------------------------------------------------------  
END_IF

IF _progress = 100 THEN
    //--------------------------------------------------------------   

    _progress := _progress + 1;

    //--------------------------------------------------------------	
END_IF

IF _progress = 101 THEN
    //--------------------------------------------------------------   
    interpReset.bExecute := TRUE;
    _status.ActionDescription := 'Waiting to interpReset.bBusy';

    IF interpReset.bBusy THEN
        _progress := _progress + 1;
    END_IF
    //--------------------------------------------------------------	
END_IF

IF _progress = 102 THEN
    //--------------------------------------------------------------   
    _status.ActionDescription := 'Waiting to NOT interpReset.bBusy';

    IF NOT interpReset.bBusy THEN
        interpReset.bExecute := FALSE;
        _progress := _progress + 1;
    END_IF

    //--------------------------------------------------------------	
END_IF

IF _progress = 103 THEN
    //--------------------------------------------------------------   
    interpBuildGroup.bExecute := TRUE;
    _status.ActionDescription := 'Waiting to interpBuildGroup.bBusy';

    IF interpBuildGroup.bBusy THEN
        _progress := _progress + 1;
    END_IF
    //--------------------------------------------------------------	
END_IF

IF _progress = 104 THEN
    //--------------------------------------------------------------   
    _status.ActionDescription := 'Waiting to NOT interpBuildGroup.bBusy';

    IF NOT interpBuildGroup.bBusy THEN
        interpBuildGroup.bExecute := FALSE;
        _progress := _progress + 1;
    END_IF

    //--------------------------------------------------------------	
END_IF

IF _progress = 105 THEN
    //--------------------------------------------------------------   
    interpLoadGCode.bExecute := TRUE;
    _status.ActionDescription := 'Waiting to interpLoadGCode.bBusy';

    IF interpLoadGCode.bBusy THEN
        _progress := _progress + 1;
    END_IF
    //--------------------------------------------------------------	
END_IF

IF _progress = 106 THEN
    //--------------------------------------------------------------   
    _status.ActionDescription := 'Waiting to NOT interpLoadGCode.bBusy and NOT interpLoadGCode.bErr ';

    IF NOT interpLoadGCode.bBusy AND NOT interpLoadGCode.bErr THEN
        interpLoadGCode.bExecute := FALSE;
        _progress := _progress + 1;
    END_IF

    //--------------------------------------------------------------	
END_IF

IF _progress = 107 THEN
    //--------------------------------------------------------------   
    _status.ActionDescription := 'Waiting to Tc2_NCI.NCI_INTERPRETER_READY';

    IF _interpreterState = Tc2_NCI.NCI_INTERPRETER_READY THEN
        _progress := _progress + 1;
    END_IF

    //--------------------------------------------------------------	
END_IF

IF _progress = 108 THEN
    //--------------------------------------------------------------   
    interpStartGCode.bStart := TRUE;
    interpStartGCode.bStop := FALSE;
    interpSingleBlock.bExecuteModeChange := TRUE;

    _status.ActionDescription := 'Waiting to interpStartGCode.bBusyY';

    IF interpStartGCode.bBusy THEN
        _progress := _progress + 1;
    END_IF
    //--------------------------------------------------------------	
END_IF

IF _progress = 109 THEN
    //--------------------------------------------------------------   
    _status.ActionDescription := 'Waiting to NOT interpStartGCode.bBusy AND NOT interpStartGCode.bErr ';

    IF NOT interpStartGCode.bBusy AND NOT interpStartGCode.bErr THEN
        interpStartGCode.bStart := FALSE;
        _progress := _progress + 1;
    END_IF

    //--------------------------------------------------------------	
END_IF

IF _progress = 110 THEN
    //--------------------------------------------------------------  
    _status.ActionDescription := 'Waiting to NOT Tc2_NCI.NCI_INTERPRETER_READY ';

    IF _interpreterState <> Tc2_NCI.NCI_INTERPRETER_READY THEN
        _progress := _progress + 1;
    END_IF

    //--------------------------------------------------------------	
END_IF

IF _progress = 111 THEN
    //-------------------------------------------------------------- 
    _status.ActionDescription := 'Waiting to Tc2_NCI.NCI_INTERPRETER_READY ';

    IF _interpreterState = Tc2_NCI.NCI_INTERPRETER_READY THEN
        _progress := _progress + 1;
    ELSIF _interpreterState = Tc2_NCI.NCI_INTERPRETER_ABORTED THEN
        Messenger.Error('<#Interpolácia prerušená.#>');
    END_IF

    //--------------------------------------------------------------	
END_IF

IF _progress = 112 THEN
    //--------------------------------------------------------------   
    interpClearGroup.bExecute := TRUE;
    _status.ActionDescription := 'Waiting to interpClearGroup.bBusy';

    IF interpClearGroup.bBusy THEN
        _progress := _progress + 1;
    END_IF
    //--------------------------------------------------------------	
END_IF

IF _progress = 113 THEN
    //--------------------------------------------------------------   
    _task.DoneWhen(TRUE);

    //--------------------------------------------------------------	
END_IF

_task.ThrowWhen(_task.ElapsedTime > _config.ErrorTime);
Messenger.OnCondition(_infoTimer.Q AND _status.ActionDescription <> '').Info(concat(TO_STRING(_progress), _status.ActionDescription));

// handling of m-functions is done outside statemachine
// M10 is signal for start and M11 is signal for stop
//IF ItpIsFastMFunc(10,THIS^.IoData.Inputs.iToPlc) THEN
//	programmedOutput := TRUE;
//END_IF

//IF ItpIsFastMFunc(11,THIS^.IoData.Inputs.iToPlc) THEN
//	programmedOutput := FALSE;
//END_IF

//// all m-functions are directly confiremd. In a real application we have of course to consider the m-function numbers to turn on/off certain functions in the machine.
//IF ItpIsHskMFunc(THIS^.IoData.Inputs.iToPlc) AND NOT interpConfirmHsk.bBusy THEN
//	interpConfirmHsk.bExecute	:= TRUE;
//ELSE	
//	interpConfirmHsk.bExecute	:= FALSE;
//END_IF	

// Hlasenie o stave priebehu volania metody
//THIS^._progressMessage.Post(Message:= CONCAT('@en-US@Executing action ~', INT_TO_STRING(THIS^._progress)), Category:= enumMessageCategory.Info);

]]></ST>
      </Implementation>
    </Method>
    <Property Name="Status" Id="{24b5d671-7ed5-0e3f-18dc-3397f067372f}">
      <Declaration><![CDATA[(*~
	<docu>
		<summary>
			Gets the status of the Interpolator 					
		</summary>			
	</docu>	
~*)
PROPERTY Status : REFERENCE TO TcoInterpolatorStatus]]></Declaration>
      <Get Name="Get" Id="{c37bb18c-a022-0624-3de0-c3aed5723416}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Status REF= _status;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>